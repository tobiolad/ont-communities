# Copy to .env for local development. Docker Compose reads this automatically.

# --- Database ---
POSTGRES_DB=ont_infrastructure
POSTGRES_USER=ont_app
POSTGRES_PASSWORD=ont_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ont_app:ont_dev_password@localhost:5432/ont_infrastructure

# --- Pipeline ---
# Official Ontario CKAN resource for "Ontario Builds: Communities"
SOURCE_RESOURCE_ID=36f92c5b-0c8b-4a4b-b4c5-d15a43894297
SOURCE_API_BASE=https://data.ontario.ca/api/3/action

# --- API ---
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000
